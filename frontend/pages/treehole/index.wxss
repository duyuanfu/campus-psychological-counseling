.treehole-page {
  padding-bottom: 120rpx;
}

.treehole-banner-card {
  background: linear-gradient(135deg, #3D8B75, #2F6F5E);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(61, 139, 117, 0.2);
}
.banner-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.banner-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}
.banner-desc {
  font-size: 22rpx;
  opacity: 0.9;
  line-height: 1.5;
}

.category-scroll {
  white-space: nowrap;
  display: flex;
  margin-bottom: 20rpx;
  height: 68rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 14rpx;
  border: 1rpx solid var(--border-color);
  box-sizing: border-box;
  vertical-align: middle;
}
.cat-chip.active {
  background: var(--primary-color);
  color: #FFFFFF;
  border-color: var(--primary-color);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 117, 0.2);
}

.post-card {
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.anon-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}
.avatar-emoji {
  font-size: 38rpx;
}
.anon-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}
.post-time {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}
.tag-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  box-sizing: border-box;
}

.post-content {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  margin: 20rpx 0 24rpx 0;
  word-break: break-all;
}

.post-footer {
  border-top: 1rpx solid #F1F5F9;
  padding-top: 20rpx;
}
.left-actions {
  gap: 32rpx;
}
.action-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #F8FAFC;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}
.action-item.hug-action.active {
  background: #FFF0F6;
  color: #EB2F96;
}
.action-icon {
  margin-right: 8rpx;
}
.report-action {
  font-size: 20rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

/* 悬浮发帖按钮 */
.fab-post-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--primary-gradient);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  padding: 18rpx 36rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(61, 139, 117, 0.4);
  z-index: 99;
  transition: transform 120ms ease;
}
.fab-post-btn:active {
  transform: scale(0.95);
}
.fab-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}
.fab-text {
  font-size: 28rpx;
  font-weight: 700;
}
