.home-container {
  padding-bottom: 60rpx;
}

/* 顶部问候卡片 (Serene Green Gradient Hero) */
.welcome-hero-card {
  background: var(--primary-gradient);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(61, 139, 117, 0.25);
}
.hero-greeting {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}
.hero-quote {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.5;
  margin-bottom: 24rpx;
  max-width: 82%;
}
.hero-meta {
  display: flex;
  gap: 16rpx;
}
.meta-tag {
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}
.hero-bg-art {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  font-size: 160rpx;
  opacity: 0.16;
  pointer-events: none;
}

/* 情绪打卡卡片 */
.mood-checkin-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.mood-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  display: flex;
  align-items: center;
}
.mood-title-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}
.mood-diary-link {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
  padding: 4rpx;
}
.mood-diary-link:active {
  opacity: 0.8;
}
.mood-options-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  gap: 12rpx;
}
.mood-opt-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  flex: 1;
  background: #F8FAFC;
  transition: all 150ms ease;
  border: 2rpx solid transparent;
}
.mood-opt-item:active {
  transform: scale(0.95);
}
.mood-opt-item.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 117, 0.18);
}
.mood-opt-emoji {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}
.mood-opt-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 数字媒体疗愈特色 */
.media-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.media-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  transition: transform 120ms ease;
}
.media-card:active {
  transform: scale(0.98);
}
.media-card-badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  background: #F1F5F9;
  color: #64748B;
  border-radius: 12rpx;
}
.breath-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F0FAF7 100%);
}
.sound-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F2F7FD 100%);
}
.breath-visual-halo {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx 0 18rpx 0;
}
.halo-circle {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  background: rgba(61, 139, 117, 0.18);
  border-radius: 50%;
}
.halo-icon {
  font-size: 40rpx;
  position: relative;
  z-index: 2;
}

/* 白噪音波浪动画条 */
.sound-visual-waves {
  height: 96rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin: 12rpx 0 18rpx 0;
  padding-left: 10rpx;
}
.sound-wave-bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #1890FF, #69C0FF);
  animation: wavePulse 1.2s infinite ease-in-out alternate;
}
.bar-1 { height: 38rpx; animation-delay: 0.1s; }
.bar-2 { height: 72rpx; animation-delay: 0.3s; }
.bar-3 { height: 50rpx; animation-delay: 0.2s; }
.bar-4 { height: 28rpx; animation-delay: 0.4s; }

@keyframes wavePulse {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1); }
}

.media-card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4rpx;
}
.media-card-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 核心服务 4 宫格 */
.quick-nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.quick-nav-item {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 22rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: transform 120ms ease;
}
.quick-nav-item:active {
  transform: scale(0.96);
}
.nav-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}
.bg-mint { background: #E6F7F0; }
.bg-sky { background: #E8F4FD; }
.bg-peach { background: #FFF0E8; }
.bg-purple { background: #F6EDFC; }
.nav-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 2rpx;
}
.nav-desc {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* 咨询师推荐卡片 */
.counselor-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.counselor-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
  border: 3rpx solid #EAF5F1;
  flex-shrink: 0;
}
.counselor-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.counselor-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}
.counselor-score {
  font-size: 22rpx;
  color: #FA8C16;
  font-weight: bold;
}
.counselor-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.counselor-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.tag-item {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}
.counselor-footer {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.counselor-location {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-book-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 24rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}

/* 科普文章卡片 */
.article-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.article-cover {
  width: 100%;
  height: 250rpx;
}
.article-body {
  padding: 24rpx;
}
.article-cat-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.article-date {
  font-size: 20rpx;
  color: var(--text-muted);
}
.article-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.article-summary {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.article-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--text-muted);
  border-top: 1rpx solid #F1F5F9;
  padding-top: 12rpx;
}

/* 危机热线 Banner */
.emergency-banner {
  background: linear-gradient(135deg, #FFF1F0, #FFECE8);
  border: 1rpx solid #FFA39E;
  border-radius: var(--radius-md);
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  transition: transform 120ms ease;
}
.emergency-banner:active {
  transform: scale(0.99);
}
.emergency-icon {
  font-size: 40rpx;
  margin-right: 14rpx;
}
.emergency-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #CF1322;
}
.emergency-num {
  font-size: 20rpx;
  color: #A8071A;
  margin-top: 2rpx;
}
.emergency-call-btn {
  background: #F5222D;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
