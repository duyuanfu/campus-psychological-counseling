.crisis-page {
  padding-bottom: 60rpx;
}

.crisis-header-banner {
  background: linear-gradient(135deg, #7A171D, #CF1322);
  color: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 30rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(207, 19, 34, 0.25);
}
.banner-icon {
  font-size: 44rpx;
  margin-right: 18rpx;
}
.banner-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.banner-desc {
  font-size: 20rpx;
  opacity: 0.9;
  line-height: 1.45;
}

.status-tabs {
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}
.tab-item {
  position: relative;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.tab-item.active {
  color: #CF1322;
  font-weight: 700;
}
.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: #CF1322;
  border-radius: 2rpx;
}

.alert-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-border-red {
  border-left: 8rpx solid #F5222D;
}
.card-border-yellow {
  border-left: 8rpx solid #FAAD14;
}

.alert-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.student-info-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.student-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
  line-height: 1.2;
}
.student-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.2;
}
.crisis-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
  flex-shrink: 0;
  vertical-align: middle;
}
.crisis-badge-red {
  background: #FFF1F0;
  color: #F5222D;
  border: 1rpx solid #FFA39E;
}
.crisis-badge-yellow {
  background: #FFFBE6;
  color: #D48806;
  border: 1rpx solid #FFE58F;
}

.alert-info-box {
  padding: 18rpx 0;
}
.info-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  line-height: 1.45;
}
.label {
  color: var(--text-muted);
  width: 160rpx;
  flex-shrink: 0;
}
.val {
  color: var(--text-secondary);
}
.text-danger-val {
  color: #CF1322;
  font-weight: 600;
}

.alert-actions {
  padding-top: 18rpx;
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.right-btn-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.alert-actions .btn-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 16rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}
.btn-phone {
  color: #1890FF;
  border-color: #91D5FF;
}
.btn-success {
  background: #52C41A;
  color: #FFFFFF;
}
.resolved-text {
  font-size: 22rpx;
  color: #52C41A;
  font-weight: 700;
}
