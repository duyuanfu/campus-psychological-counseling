.record-edit-page {
  padding-bottom: 60rpx;
}

.top-nav-tabs {
  background: #FFFFFF;
  padding: 12rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  color: var(--text-secondary);
}
.tab-btn.active {
  background: #EAF5F1;
  color: var(--primary-color);
  font-weight: 700;
}

.form-card {
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.form-item {
  margin-top: 18rpx;
}
.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}
.form-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-main);
  box-sizing: border-box;
}
.picker-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-main);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.arrow {
  color: var(--text-muted);
}
.form-textarea {
  width: 100%;
  height: 140rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.submit-wrap {
  margin-top: 30rpx;
}
.btn-save {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
}

/* 档案列表 */
.record-file-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.file-header {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.file-student {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
}
.file-major {
  font-size: 22rpx;
  color: var(--text-muted);
}

.file-body {
  padding: 16rpx 0;
}
.file-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  line-height: 1.45;
}
.f-label {
  color: var(--text-muted);
  width: 140rpx;
  flex-shrink: 0;
}
.f-val {
  color: var(--text-secondary);
}
.f-val.clamp {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.file-footer {
  padding-top: 14rpx;
  border-top: 1rpx solid #F1F5F9;
}
.f-id {
  font-size: 20rpx;
  color: var(--text-muted);
}
.btn-sm {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  margin: 0;
}
