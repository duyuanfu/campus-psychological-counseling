.counselor-apts-page {
  padding-bottom: 60rpx;
}

.status-tabs {
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.tab-item {
  position: relative;
  padding: 12rpx 14rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.tab-item.active {
  color: var(--primary-color);
  font-weight: 700;
}
.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.apt-manage-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.apt-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.student-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
}

.apt-body {
  padding: 18rpx 0;
}
.info-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  line-height: 1.45;
}
.info-label {
  color: var(--text-muted);
  width: 140rpx;
  flex-shrink: 0;
}
.info-val {
  color: var(--text-main);
}
.info-val.highlight {
  color: var(--primary-color);
  font-weight: 600;
}
.info-val.phone {
  color: #1890FF;
}
.info-val.desc {
  color: var(--text-secondary);
}

.feedback-box {
  background: #F8FAFC;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
}
.feedback-title {
  color: var(--text-muted);
  font-weight: 600;
}
.feedback-text {
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.apt-actions {
  padding-top: 18rpx;
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.id-tag {
  font-size: 20rpx;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}
.btn-group {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.btn-sm {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  border-radius: var(--radius-full);
}
.btn-reject {
  color: #F5222D;
  border-color: #FFA39E;
}

/* Modal 遮罩 */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  padding: 40rpx;
}
.modal-card {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 36rpx 30rpx;
  width: 100%;
  max-width: 640rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
  text-align: center;
}
.modal-title.text-danger {
  color: #F5222D;
}
.modal-field {
  margin-bottom: 20rpx;
}
.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.modal-input {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
.modal-textarea {
  width: 100%;
  height: 140rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
.modal-btn-row {
  margin-top: 30rpx;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 18rpx;
}
