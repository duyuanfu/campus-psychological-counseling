.counselor-dash-page {
  padding-bottom: 60rpx;
}

.counselor-hero-card {
  padding: 28rpx 24rpx;
  background: #FFFFFF;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #EAF5F1;
}
.c-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}
.c-title {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-top: 4rpx;
}
.c-dept {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}
.btn-switch-back {
  width: auto !important;
  min-width: 130rpx !important;
  max-width: 160rpx !important;
  margin: 0 !important;
  padding: 8rpx 20rpx !important;
  font-size: 22rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}

.crisis-notify-bar {
  background: #FFF1F0;
  border: 2rpx solid #FFA39E;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.alert-icon {
  font-size: 38rpx;
  margin-right: 14rpx;
}
.alert-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #CF1322;
}
.alert-sub {
  font-size: 20rpx;
  color: #A8071A;
  margin-top: 2rpx;
}
.alert-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #F5222D;
  flex-shrink: 0;
}

.metrics-card {
  padding: 28rpx 10rpx;
  margin-bottom: 24rpx;
}
.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.metric-num {
  font-size: 40rpx;
  font-weight: 800;
}
.metric-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}
.text-orange { color: #FA8C16; }
.text-green { color: #52C41A; }
.text-red { color: #F5222D; }

.work-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.work-card {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.card-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 14rpx;
}
.bg-mint { background: #E6F7F0; }
.bg-sky { background: #E8F4FD; }
.bg-danger { background: #FFF1F0; }
.bg-purple { background: #F6EDFC; }

.work-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.work-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1.4;
  margin-bottom: 16rpx;
  min-height: 56rpx;
}
.work-arrow {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.pending-card {
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}
.pending-student {
  gap: 12rpx;
}
.s-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}
.pending-time {
  font-size: 22rpx;
  color: var(--primary-color);
  margin: 6rpx 0;
  font-weight: 500;
}
.pending-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
.btn-deal-sm {
  font-size: 22rpx;
  padding: 10rpx 26rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}
