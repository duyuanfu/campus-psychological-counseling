.article-manage-page {
  padding-bottom: 60rpx;
}

.create-bar {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.bar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}
.bar-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.btn-new {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin: 0;
  flex-shrink: 0;
}

.article-item-card {
  padding: 20rpx;
  margin-bottom: 18rpx;
}
.cover-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.art-badge-row {
  margin-bottom: 6rpx;
}
.art-date {
  font-size: 20rpx;
  color: var(--text-muted);
}
.art-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.art-meta {
  font-size: 20rpx;
  color: var(--text-muted);
  display: flex;
  justify-content: space-between;
}
.act-col {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.btn-xs {
  width: auto !important;
  margin: 0 !important;
  font-size: 20rpx !important;
  padding: 6rpx 14rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 20rpx !important;
}
.btn-del {
  color: #F5222D;
  border-color: #FFA39E;
}

/* Modal */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  padding: 30rpx;
}
.modal-card {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 30rpx 24rpx;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
}
.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}
.modal-item {
  margin-bottom: 16rpx;
}
.label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}
.input {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}
.picker-box {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
}
.arrow { color: var(--text-muted); }
.textarea {
  width: 100%;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}
.summary-area { height: 100rpx; }
.body-area { height: 160rpx; }
.modal-btn-row {
  margin-top: 24rpx;
  gap: 16rpx;
}
.modal-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx;
}
