.treehole-audit-page {
  padding-bottom: 60rpx;
}

.audit-notice-card {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #D48806;
  margin-bottom: 4rpx;
}
.notice-desc {
  font-size: 22rpx;
  color: #874D00;
  line-height: 1.45;
}

.post-audit-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.anon-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.anon-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
}
.post-time {
  font-size: 20rpx;
  color: var(--text-muted);
}
.post-body-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  margin: 16rpx 0;
  word-break: break-all;
}
.post-stats-row {
  font-size: 20rpx;
  color: var(--text-muted);
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.post-audit-actions {
  padding-top: 16rpx;
}
.btn-right-group {
  gap: 12rpx;
}
.btn-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 18rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}
.btn-crisis {
  color: #FA8C16;
  border-color: #FFD591;
}
.btn-delete {
  color: #F5222D;
  border-color: #FFA39E;
}
.btn-pass {
  background: #52C41A;
}
