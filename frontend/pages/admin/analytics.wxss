.analytics-page {
  background-color: #0B1120;
  min-height: 100vh;
  color: #F8FAFC;
  padding-bottom: 60rpx;
}

.bigscreen-header {
  padding: 10rpx 0 24rpx 0;
  border-bottom: 1rpx solid #1E293B;
  margin-bottom: 24rpx;
}
.bigscreen-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #F8FAFC;
}
.dot-live {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 12rpx #10B981;
  margin-right: 12rpx;
}
.bigscreen-time {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}
.safe-badge {
  background: rgba(16, 185, 129, 0.15);
  border: 1rpx solid #10B981;
  color: #10B981;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  gap: 6rpx;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.kpi-card {
  background: #1E293B;
  border: 1rpx solid #334155;
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
}
.kpi-num {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}
.kpi-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}
.kpi-trend {
  font-size: 18rpx;
  margin-top: 4rpx;
}
.text-cyan { color: #06B6D4; }
.text-purple { color: #A855F7; }
.text-green { color: #10B981; }
.text-amber { color: #F59E0B; }
.text-blue { color: #3B82F6; }

.chart-box-card {
  background: #1E293B;
  border: 1rpx solid #334155;
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
}
.chart-box-header {
  margin-bottom: 6rpx;
}
.chart-box-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F8FAFC;
}
.chart-box-sub {
  font-size: 20rpx;
  color: #64748B;
  margin-bottom: 16rpx;
}
.canvas-wrap {
  width: 100%;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.screen-canvas {
  width: 100%;
  height: 100%;
}

.rank-card {
  background: #1E293B;
  border: 1rpx solid #334155;
  border-radius: var(--radius-md);
  padding: 24rpx;
}
.rank-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rank-item-header {
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
.rank-idx {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  margin-right: 12rpx;
  background: #334155;
  color: #94A3B8;
}
.idx-1 { background: #EF4444; color: #FFFFFF; }
.idx-2 { background: #F97316; color: #FFFFFF; }
.idx-3 { background: #EAB308; color: #FFFFFF; }
.rank-name {
  color: #E2E8F0;
  font-weight: 600;
}
.rank-pct {
  color: #94A3B8;
  font-size: 22rpx;
}
.rank-progress-track {
  width: 100%;
  height: 10rpx;
  background: #334155;
  border-radius: 5rpx;
  overflow: hidden;
}
.rank-progress-fill {
  height: 100%;
  border-radius: 5rpx;
}
