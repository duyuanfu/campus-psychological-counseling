.login-container {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, #F0F7F4 0%, #F8FAFC 50%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0 36rpx 0;
}
.brand-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 12rpx 28rpx rgba(61, 139, 117, 0.28);
  margin-bottom: 20rpx;
}
.brand-name {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 2rpx;
}
.brand-slogan {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.login-box {
  padding: 36rpx 28rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.role-switch {
  background: #F1F5F9;
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: 36rpx;
}
.role-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  transition: all 150ms ease;
}
.role-btn.active {
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.08);
}
.r-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}
.r-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
.role-btn.active .r-text {
  color: var(--primary-color);
  font-weight: 700;
}

.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.input-cell {
  height: 84rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  align-items: center;
  box-sizing: border-box;
  transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
}
.input-cell:focus-within {
  border-color: var(--primary-color);
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(61, 139, 117, 0.12);
}
.cell-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  opacity: 0.55;
}
.cell-input {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}
.cell-toggle {
  font-size: 30rpx;
  padding: 0 8rpx;
  opacity: 0.6;
}

.quick-row {
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.quick-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.2;
}
.quick-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
  vertical-align: middle;
  transition: opacity 120ms ease;
}
.quick-action:active {
  opacity: 0.75;
}

.btn-submit {
  width: 100%;
  padding: 22rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border-radius: var(--radius-full);
  margin-bottom: 24rpx;
}

.action-footer {
  margin-top: 16rpx;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 24rpx;
  white-space: nowrap;
  width: 100%;
}
.footer-hint {
  color: var(--text-muted);
  margin-right: 6rpx;
  white-space: nowrap;
}
.footer-link {
  color: var(--primary-color);
  font-weight: 600;
  white-space: nowrap;
  padding: 4rpx;
}
.footer-link:active {
  opacity: 0.8;
}

.footer-security {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
.sec-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}
