.mine-page {
  padding-bottom: 70rpx;
  background-color: var(--bg-color);
}

/* 个人名片 (Apple Profile Header) */
.user-profile-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
}
.user-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
  flex-shrink: 0;
}
.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

/* 姓名与已认证标签严格垂直居中对齐 */
.user-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  line-height: 1.2;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

/* iOS 风格微胶囊认证徽章：几何中心绝对垂直对齐 */
.cert-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 19rpx;
  font-size: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
  vertical-align: middle;
  flex-shrink: 0;
}
.cert-badge-success {
  background: rgba(82, 196, 26, 0.12);
  color: #237804;
  border: 1rpx solid rgba(82, 196, 26, 0.35);
}
.cert-badge-warning {
  background: rgba(250, 173, 20, 0.12);
  color: #AD6800;
  border: 1rpx solid rgba(250, 173, 20, 0.35);
}

.user-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.user-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.edit-btn-box {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
  flex-shrink: 0;
}
.edit-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}
.ios-chevron {
  font-size: 32rpx;
  color: #94A3B8;
  font-weight: 400;
  line-height: 1;
}

/* 工作台快速入口 (iOS Banner) */
.counselor-quick-entrance, .admin-quick-entrance {
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}
.counselor-quick-entrance {
  background: linear-gradient(135deg, #F0F7FF 0%, #E6F4FF 100%);
  border: 1rpx solid #BAE0FF;
}
.admin-quick-entrance {
  background: linear-gradient(135deg, #FFF1F0 0%, #FFECE8 100%);
  border: 1rpx solid #FFA39E;
}
.entrance-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.bg-blue { background: #BAE0FF; }
.bg-red { background: #FFCCC7; }
.quick-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}
.quick-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.btn-enter-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 24rpx !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}

/* 数据看板 (iOS Grouped Metric Row) */
.stats-card {
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-md);
}
.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  transition: transform 120ms ease;
}
.stat-block:active {
  transform: scale(0.96);
}
.stat-block .num {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--primary-color);
  line-height: 1.1;
}
.stat-block .label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E2E8F0;
}

/* iOS Settings 风格菜单列表 */
.menu-card {
  padding: 4rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-md);
}
.menu-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  opacity: 0.75;
}

/* iOS 风格彩色图标小方块 */
.menu-icon-tile {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.tile-coral { background: #FFF0ED; }
.tile-blue { background: #E6F4FF; }
.tile-purple { background: #F9F0FF; }
.tile-green { background: #EAF5F1; }
.tile-teal { background: #E6FFFB; }
.tile-red { background: #FFF1F0; }
.tile-gray { background: #F1F5F9; }

.menu-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
.menu-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 8rpx;
}

/* 底部服务与热线 */
.info-card {
  padding: 4rpx 28rpx;
  margin-bottom: 30rpx;
  border-radius: var(--radius-md);
}
.info-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.info-item:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.info-val {
  font-size: 24rpx;
  color: var(--text-muted);
}
.info-val.phone {
  color: var(--danger-red);
  font-weight: 700;
  margin-right: 6rpx;
}

/* 退出登录 (Apple iOS Style Action Button) */
.logout-section {
  margin-top: 10rpx;
}
.btn-logout {
  width: 100% !important;
  background: #FFFFFF !important;
  color: #DC2626 !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  padding: 22rpx 0 !important;
  border-radius: var(--radius-full) !important;
  border: 1rpx solid #FCA5A5 !important;
  box-shadow: var(--shadow-sm) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 120ms ease;
}
.btn-logout:active {
  background: #FEF2F2 !important;
  transform: scale(0.98);
}
