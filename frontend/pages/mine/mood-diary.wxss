.mood-diary-page {
  padding-bottom: 70rpx;
  background-color: var(--bg-color);
}

.new-diary-card {
  padding: 32rpx 26rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-md);
}

/* 5 档情绪打分卡片 */
.mood-levels-row {
  display: flex;
  justify-content: space-between;
  margin: 22rpx 0;
  gap: 12rpx;
}
.mood-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  flex: 1;
  border: 2rpx solid transparent;
  transition: all 150ms ease;
}
.mood-opt:active {
  transform: scale(0.95);
}
.mood-opt.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 117, 0.16);
}
.opt-emoji {
  font-size: 42rpx;
  margin-bottom: 6rpx;
}
.opt-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.tags-section {
  margin: 20rpx 0;
}
.tags-title {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}
.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: var(--text-secondary);
  box-sizing: border-box;
  transition: all 120ms ease;
}
.tag-chip:active {
  transform: scale(0.96);
}
.tag-chip.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  color: var(--primary-color);
  font-weight: 600;
}

.diary-input {
  width: 100%;
  height: 180rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: var(--radius-md);
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-main);
  box-sizing: border-box;
  margin: 20rpx 0;
  transition: all 150ms ease;
}
.diary-input:focus {
  border-color: var(--primary-color);
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(61, 139, 117, 0.12);
}

.btn-save-diary {
  width: 100% !important;
  padding: 22rpx 0 !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: var(--radius-full) !important;
}

/* 时间轴卡片 */
.timeline-card {
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid var(--primary-color);
  border-radius: var(--radius-md);
}
.diary-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.diary-mood-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}
.diary-date {
  font-size: 20rpx;
  color: var(--text-muted);
}
.diary-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0;
}
.diary-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
}
