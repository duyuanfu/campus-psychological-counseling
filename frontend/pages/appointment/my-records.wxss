.my-records-page {
  padding-bottom: 60rpx;
}

.status-tabs {
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.tab-item {
  position: relative;
  padding: 12rpx 14rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.tab-item.active {
  color: var(--primary-color);
  font-weight: 700;
}
.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.record-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.record-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F5F9;
}
.c-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
}
.c-title {
  font-size: 22rpx;
  color: var(--text-muted);
}

.record-body {
  padding: 18rpx 0;
}
.meta-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  line-height: 1.45;
}
.meta-icon {
  margin-right: 10rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.meta-label {
  color: var(--text-muted);
  width: 140rpx;
  flex-shrink: 0;
}
.meta-value {
  color: var(--text-main);
  flex: 1;
  word-break: break-all;
}
.meta-value.id-code {
  color: #64748B;
  font-family: monospace;
}
.meta-value.highlight {
  color: var(--primary-color);
  font-weight: 600;
}
.meta-value.desc {
  color: var(--text-secondary);
}

.feedback-box {
  background: #F8FAFC;
  border-left: 6rpx solid var(--primary-color);
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-top: 14rpx;
}
.feedback-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 4rpx;
}
.feedback-content {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

/* 底部操作栏：左侧提示与右侧操作按钮，整洁无拥挤 */
.record-footer {
  padding-top: 18rpx;
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.mode-tip-text {
  font-size: 22rpx;
  color: var(--text-muted);
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
.btn-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0 !important;
}
.btn-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 16rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}
.btn-cancel {
  border-color: #D9D9D9;
  color: #595959;
}
