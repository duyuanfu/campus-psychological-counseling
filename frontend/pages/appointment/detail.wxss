.counselor-detail-page {
  padding-bottom: 150rpx;
}

.counselor-profile-card {
  padding: 30rpx 24rpx;
}
.avatar-lg {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
  border: 4rpx solid #EAF5F1;
}
.name-title-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.c-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}
.c-badge {
  font-size: 20rpx;
  background: #EAF5F1;
  color: var(--primary-color);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}
.c-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.c-college {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.c-rating {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}
.star {
  color: #FA8C16;
  font-size: 24rpx;
}
.rate-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #FA8C16;
  margin-left: 6rpx;
}
.rate-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: 10rpx;
}

.support-modes-row {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--border-color);
  display: flex;
  align-items: center;
}
.mode-label {
  font-size: 22rpx;
  color: var(--text-muted);
}
.modes-tags {
  display: flex;
  gap: 12rpx;
}
.mode-tag {
  font-size: 22rpx;
}

.intro-card {
  padding: 28rpx 24rpx;
}
.intro-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 16rpx;
}
.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.tag-pill {
  font-size: 22rpx;
}

/* 排班选择 */
.schedule-card {
  padding: 28rpx 24rpx;
}
.schedule-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  margin-bottom: 20rpx;
}

.dates-scroll {
  white-space: nowrap;
  display: flex;
  margin-bottom: 24rpx;
  padding: 4rpx 0;
}
.date-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 18rpx 16rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  min-width: 136rpx;
  box-sizing: border-box;
}
.date-cell.selected {
  background: #EAF5F1;
  border-color: var(--primary-color);
}
.day-name {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.2;
  margin-bottom: 6rpx;
  display: block;
}
.day-number {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  margin-bottom: 8rpx;
  display: block;
}
.status-dot {
  width: 100%;
  text-align: center;
  font-size: 18rpx;
  padding: 4rpx 0;
  border-radius: 10rpx;
  line-height: 1.2;
  display: block;
  box-sizing: border-box;
}
.status-dot.available {
  background: #D9F7BE;
  color: #389E0D;
}
.status-dot.busy {
  background: #F5F5F5;
  color: #8C8C8C;
}

.slots-section {
  margin-top: 20rpx;
  border-top: 1rpx solid #F1F5F9;
  padding-top: 20rpx;
}
.slots-header {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}
.slots-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.slot-btn {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.slot-btn.active {
  background: #EAF5F1;
  border-color: var(--primary-color);
}
.slot-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}
.slot-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.notice-card {
  padding: 24rpx;
}
.info-row {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.info-label {
  font-weight: 600;
  color: var(--text-main);
}
.info-val {
  color: var(--text-secondary);
}

/* 底部操作栏 (Apple iOS Floating Action Bar) */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.preview-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
}
.preview-text .placeholder {
  color: var(--text-muted);
  font-weight: normal;
}
.preview-sub {
  font-size: 20rpx;
  color: var(--primary-color);
  margin-top: 4rpx;
  font-weight: 500;
}
.btn-submit-book {
  width: auto !important;
  margin: 0 !important;
  padding: 18rpx 44rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: var(--radius-full) !important;
  flex-shrink: 0 !important;
}
