.appointment-page {
  padding-bottom: 50rpx;
}

.record-entry-bar {
  background: #FFFFFF;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  border-left: 8rpx solid var(--primary-color);
}
.bar-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}
.bar-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}
.bar-badge {
  gap: 10rpx;
  align-items: center;
}
.arrow {
  color: var(--text-muted);
  font-size: 24rpx;
}

.notice-card {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: var(--radius-md);
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.notice-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #D48806;
  margin-bottom: 4rpx;
}
.notice-desc {
  font-size: 22rpx;
  color: #874D00;
  line-height: 1.45;
}

/* 顶部专长分类栏：紧凑高度，严格垂直居中 */
.category-scroll {
  white-space: nowrap;
  display: flex;
  margin-bottom: 20rpx;
  height: 68rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 14rpx;
  border: 1rpx solid var(--border-color);
  box-sizing: border-box;
  vertical-align: middle;
}
.cat-chip.active {
  background: var(--primary-color);
  color: #FFFFFF;
  border-color: var(--primary-color);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(61, 139, 117, 0.2);
}

/* 咨询师列表卡片 */
.counselor-item-card {
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
}
.counselor-main {
  display: flex;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  border: 3rpx solid #EAF5F1;
  flex-shrink: 0;
}
.name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 10rpx;
}
.title-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
}
.rating-box {
  align-items: center;
}
.star {
  color: #FA8C16;
  font-size: 22rpx;
  margin-right: 2rpx;
}
.rating-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #FA8C16;
}
.reviews {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-left: 4rpx;
}
.title-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.tag-item {
  font-size: 20rpx;
  background: #F1F5F9;
  color: #475569;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.intro-clamp {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部操作与时间栏：空间合理分配，绝对不换行 */
.counselor-bottom-bar {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.work-time {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.time-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.time-text {
  font-size: 22rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-group {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}
.btn-detail-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 16rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}
.btn-book-sm {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 18rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}
