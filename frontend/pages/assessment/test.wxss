.test-page {
  padding-bottom: 80rpx;
}

.progress-box {
  margin-bottom: 24rpx;
}
.progress-header {
  margin-bottom: 12rpx;
}
.scale-code-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary-color);
}
.progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}
.progress-track {
  width: 100%;
  height: 12rpx;
  background: #E2E8F0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3D8B75, #52C41A);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.question-card {
  padding: 36rpx 28rpx;
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
}
.question-dim-tag {
  align-self: flex-start;
  font-size: 20rpx;
  background: #F1F5F9;
  color: #64748B;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
}
.question-num-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}
.question-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.45;
  margin-bottom: 16rpx;
}
.instruction-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 30rpx;
}

.options-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex: 1;
}
.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 18rpx;
  transition: all 0.2s ease;
}
.option-item.selected {
  background: #EAF5F1;
  border-color: var(--primary-color);
  box-shadow: 0 4rpx 14rpx rgba(61, 139, 117, 0.15);
}
.option-check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #CBD5E1;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}
.option-item.selected .option-check-circle {
  background: var(--primary-color);
  border-color: var(--primary-color);
}
.option-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.nav-actions {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.btn-prev {
  flex: 1;
  padding: 22rpx 0;
  font-size: 26rpx;
  line-height: 1.3;
}
.btn-next {
  flex: 1;
  padding: 22rpx 0;
  font-size: 26rpx;
  line-height: 1.3;
}
.btn-submit-test {
  flex: 1;
  padding: 22rpx 0;
  font-size: 28rpx;
  line-height: 1.3;
  background: var(--primary-gradient);
}
