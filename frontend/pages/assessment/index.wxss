.assessment-page {
  padding-bottom: 60rpx;
}

.assessment-hero-card {
  background: linear-gradient(135deg, #4A5568, #2D3748);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(45, 55, 72, 0.25);
}
.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.hero-desc {
  font-size: 22rpx;
  opacity: 0.85;
  line-height: 1.5;
  margin-bottom: 28rpx;
}
.hero-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  align-self: center;
}
.stat-item .num {
  font-size: 28rpx;
  font-weight: 700;
  color: #68D391;
}
.stat-item .label {
  font-size: 18rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 最近测评速览 */
.latest-report-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F0FAF7 100%);
  border: 1rpx solid #D1EBE1;
  padding: 24rpx;
}
.card-title-sm {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}
.card-title-sm .icon {
  margin-right: 8rpx;
}
.report-date {
  font-size: 20rpx;
  color: var(--text-muted);
}
.latest-score-row {
  margin: 16rpx 0;
}
.score-val {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--primary-color);
  line-height: 1;
}
.score-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-left: 8rpx;
}
.latest-analysis-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.45;
  margin-bottom: 16rpx;
}
.btn-view-report {
  width: 100%;
  font-size: 24rpx;
  padding: 12rpx;
  text-align: center;
}

/* 量表列表 */
.scale-card {
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.scale-header {
  margin-bottom: 12rpx;
}
.tested-count {
  font-size: 20rpx;
  color: var(--text-muted);
}
.scale-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}
.scale-subtitle {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.scale-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin: 16rpx 0 20rpx 0;
}
.scale-meta-row {
  border-top: 1rpx solid #F1F5F9;
  padding-top: 20rpx;
}
.scale-specs {
  gap: 16rpx;
}
.spec-tag {
  font-size: 22rpx;
  color: var(--text-muted);
}
.btn-start-test {
  width: auto !important;
  margin: 0 !important;
  font-size: 24rpx !important;
  padding: 10rpx 32rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: 30rpx !important;
  flex-shrink: 0 !important;
}

/* 历史列表 */
.history-item {
  padding: 22rpx 24rpx;
}
.history-scale-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}
.history-date {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.history-score-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 16rpx;
}
.h-score {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}
.h-level {
  font-size: 20rpx;
  font-weight: 600;
}
.arrow {
  color: var(--text-muted);
  font-size: 24rpx;
}
