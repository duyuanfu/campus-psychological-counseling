/**
 * 全局样式系统 - 心语树高校心理咨询
 * 基于 UI/UX Pro Max 规范：Neumorphism / Soft UI + Accessible & Ethical
 */

page {
  /* 品牌核心主色调 (森系治愈绿与身心舒缓色) */
  --primary-color: #3D8B75;
  --primary-light: #EAF5F1;
  --primary-dark: #276756;
  --primary-gradient: linear-gradient(135deg, #3D8B75 0%, #2A6E5C 100%);
  --primary-shadow: 0 8rpx 20rpx rgba(61, 139, 117, 0.28);

  /* 功能色彩 */
  --accent-orange: #FA8C16;
  --accent-orange-light: #FFF7E6;
  --accent-purple: #722ED1;
  --accent-purple-light: #F9F0FF;
  --accent-blue: #1890FF;
  --accent-blue-light: #E6F7FF;
  --danger-red: #F5222D;
  --danger-red-light: #FFF1F0;
  --warning-yellow: #FAAD14;
  --warning-yellow-light: #FFFBE6;
  --success-green: #52C41A;
  --success-green-light: #F6FFED;

  /* 文字层级色彩 (WCAG AAA/AA 4.5:1+ 严格无障碍对比度) */
  --text-main: #0F172A;        /* Slate-900: 主要标题与重点文字 */
  --text-secondary: #334155;   /* Slate-700: 正文与重要副标题 */
  --text-muted: #64748B;       /* Slate-500: 辅助说明、元数据 */
  --text-disabled: #94A3B8;    /* Slate-400: 占位符、禁用态 */

  /* 界面底色与卡片 */
  --bg-color: #F8FAFC;         /* 整体页面宁静浅底色 */
  --card-bg: #FFFFFF;          /* 卡片纯白表面 */
  --border-color: #E2E8F0;     /* 极简细边框 */
  --border-light: #F1F5F9;

  /* 柔和阴影系统 (Soft UI / Neumorphism Evolution) */
  --shadow-sm: 0 2rpx 8rpx rgba(15, 23, 42, 0.04), 0 1rpx 2rpx rgba(15, 23, 42, 0.02);
  --shadow-md: 0 8rpx 24rpx rgba(15, 23, 42, 0.06), 0 2rpx 6rpx rgba(15, 23, 42, 0.03);
  --shadow-lg: 0 16rpx 36rpx rgba(61, 139, 117, 0.12);

  /* 圆角规范 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;

  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

/* 微信小程序全局按钮重置 (彻底消除 184px 膨胀与边框白边) */
button {
  margin: 0;
  padding: 0;
  width: auto;
  font-weight: normal;
  background: transparent;
  line-height: 1;
}

button::after {
  border: none;
}

/* 布局原子工具类 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-around {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 卡片系统 (Soft Card with Crisp Subtle Border) */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: transform 150ms ease, box-shadow 150ms ease;
}

.card:active {
  transform: translateY(1rpx);
}

/* 标题规范 (清晰视觉锚点) */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  padding-left: 6rpx;
  padding-right: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  display: flex;
  align-items: center;
  line-height: 1.3;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 按钮规范 (严格满足 44px 移动触控目标与触觉反馈) */
.btn-primary {
  background: var(--primary-gradient);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--primary-shadow);
  border: none;
  line-height: 1.2;
  transition: transform 120ms ease, opacity 120ms ease;
}

.btn-primary:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary-color);
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.2;
  transition: transform 120ms ease;
}

.btn-secondary:active {
  transform: scale(0.98);
}

.btn-outline {
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  background: #FFFFFF;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  transition: transform 120ms ease;
}

.btn-outline:active {
  background: var(--primary-light);
  transform: scale(0.98);
}

.btn-danger {
  background: linear-gradient(135deg, #F5222D 0%, #CF1322 100%);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(245, 34, 45, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  transition: transform 120ms ease;
}

.btn-danger:active {
  transform: scale(0.98);
}

.btn-sm {
  width: auto !important;
  margin: 0 !important;
  padding: 8rpx 20rpx !important;
  font-size: 22rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: var(--radius-full) !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: transform 120ms ease;
}

.btn-sm:active {
  transform: scale(0.96);
}

.btn-xs {
  width: auto !important;
  margin: 0 !important;
  padding: 6rpx 14rpx !important;
  font-size: 20rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  border-radius: var(--radius-full) !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* 标签 Badge / Tag 规范 (居中、微型胶囊) */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  box-sizing: border-box;
  vertical-align: middle;
}

.badge-primary {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.badge-warm {
  background: var(--accent-orange-light);
  color: #D46B08;
}

.badge-purple {
  background: var(--accent-purple-light);
  color: var(--accent-purple);
}

.badge-danger {
  background: var(--danger-red-light);
  color: var(--danger-red);
  border: 1rpx solid #FFA39E;
}

.badge-warning {
  background: var(--warning-yellow-light);
  color: #B78103;
  border: 1rpx solid #FFE58F;
}

.badge-success {
  background: var(--success-green-light);
  color: #389E0D;
  border: 1rpx solid #B7EB8F;
}

/* 状态药丸 Pill */
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 0 16rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  vertical-align: middle;
}
.status-pill.pending {
  background: var(--warning-yellow-light);
  color: #B78103;
  border: 1rpx solid #FFE58F;
}
.status-pill.confirmed {
  background: var(--primary-light);
  color: var(--primary-dark);
  border: 1rpx solid #A7E0D0;
}
.status-pill.completed {
  background: #F0F5FF;
  color: #1D39C4;
  border: 1rpx solid #ADC6FF;
}
.status-pill.rejected, .status-pill.canceled {
  background: var(--danger-red-light);
  color: var(--danger-red);
  border: 1rpx solid #FFA39E;
}

/* 空状态 (Empathetic Empty State) */
.empty-box {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 动效：光晕呼吸 (用于呼吸训练与心晴状态) */
@keyframes breatheGlow {
  0% {
    transform: scale(0.92);
    box-shadow: 0 0 0 0 rgba(61, 139, 117, 0.35);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 0 40rpx 16rpx rgba(61, 139, 117, 0.22);
  }
  100% {
    transform: scale(0.92);
    box-shadow: 0 0 0 0 rgba(61, 139, 117, 0.35);
  }
}

.breathe-animation {
  animation: breatheGlow 4s infinite ease-in-out;
}
