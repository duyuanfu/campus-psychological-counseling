.schedule-page {
  padding-bottom: 50rpx;
}

.days-check {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 26rpx;
  padding: 10rpx 0;
}

.check-item {
  display: flex;
  align-items: center;
  width: 45%;
}

.slots-check {
  display: flex;
  flex-direction: column;
}

.slot-check-item {
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 26rpx;
}

.btn-block {
  width: 100% !important;
  padding: 22rpx 0 !important;
  font-size: 28rpx !important;
}
