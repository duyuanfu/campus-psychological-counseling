.crisis-page {
  padding-bottom: 50rpx;
}

.alert-header {
  background: #feebee;
  border-color: #ffcdd2;
}

.a-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--error-color);
}

.a-desc {
  font-size: 22rpx;
  color: #515a6e;
  margin-top: 6rpx;
}

.alert-card {
  border-left: 6rpx solid var(--error-color);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.a-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
}

.a-name {
  font-size: 28rpx;
  font-weight: bold;
  flex: 1;
  min-width: 0;
  line-height: 1.2;
}

.row {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.lbl {
  color: var(--sub-color);
  width: 140rpx;
  display: inline-block;
}

.color-red {
  color: var(--error-color);
  font-weight: 500;
}

.a-actions {
  border-top: 1px solid #f0f0f0;
  padding-top: 14rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.a-actions button {
  width: auto !important;
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 8rpx 20rpx !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
