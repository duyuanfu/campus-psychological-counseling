.article-page {
  padding-bottom: 50rpx;
}

.a-title {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.a-meta {
  font-size: 22rpx;
  color: var(--sub-color);
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 14rpx;
  margin-bottom: 20rpx;
}

.a-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.a-summary {
  background: #f8f8f9;
  border-left: 6rpx solid var(--primary-color);
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.p {
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
