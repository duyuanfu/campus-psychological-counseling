.relax-page {
  padding-bottom: 50rpx;
}

.breath-tip {
  font-size: 22rpx;
  color: var(--sub-color);
  margin-bottom: 30rpx;
}

.breath-circle-wrap {
  height: 340rpx;
}

.breath-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #e8f4ff;
  border: 4px solid var(--primary-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 1s ease-in-out;
}

.breath-circle.inhale {
  transform: scale(1.3);
  transition: transform 4s ease-in;
}

.breath-circle.hold {
  transform: scale(1.3);
}

.breath-circle.exhale {
  transform: scale(0.9);
  transition: transform 8s ease-out;
}

.b-text {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.b-time {
  font-size: 24rpx;
  color: var(--text-color);
  margin-top: 6rpx;
}

.breath-action {
  margin-top: 20rpx;
}

.current-sound {
  background: #f8f8f9;
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.s-icon {
  font-size: 44rpx;
  margin-right: 14rpx;
}

.s-name {
  font-size: 26rpx;
  font-weight: bold;
}

.s-desc {
  font-size: 20rpx;
  color: var(--sub-color);
}

.sound-grid {
  display: flex;
  justify-content: space-between;
}

.sound-cell {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border: 1px solid var(--border-color);
  border-radius: 6rpx;
  margin: 0 6rpx;
  background: #ffffff;
}

.sound-cell.active {
  background: #e8f4ff;
  border-color: var(--primary-color);
}

.cell-icon {
  font-size: 32rpx;
}

.cell-name {
  font-size: 20rpx;
  margin-top: 4rpx;
  display: block;
}
