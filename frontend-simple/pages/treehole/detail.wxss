.detail-page {
  padding-bottom: 50rpx;
}

.d-avatar {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.d-name {
  font-size: 28rpx;
  font-weight: bold;
}

.d-content {
  font-size: 28rpx;
  line-height: 1.6;
  margin: 20rpx 0;
}

.d-time {
  font-size: 20rpx;
  color: var(--sub-color);
  border-top: 1px solid #f0f0f0;
  padding-top: 12rpx;
}

.comment-item {
  padding: 14rpx 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 24rpx;
}

.c-user {
  font-weight: bold;
  color: var(--primary-color);
}

.c-text {
  margin-top: 4rpx;
  color: var(--text-color);
}

.reply-card {
  padding: 16rpx 20rpx;
}
