.book-page {
  padding-bottom: 50rpx;
}

.reschedule-tip {
  background: #fff9e6;
  border: 1px solid #ffe58f;
  color: #d48806;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.row {
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.label {
  color: var(--sub-color);
  width: 140rpx;
  display: inline-block;
}

.highlight {
  color: var(--primary-color);
  font-weight: bold;
}

.radio-row {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  padding: 10rpx 0;
}

.btn-block {
  width: 100% !important;
  padding: 22rpx 0 !important;
  font-size: 28rpx !important;
}
