.appointment-page {
  padding-bottom: 50rpx;
}

.record-btn-card {
  background: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-color);
}

.category-row {
  display: flex;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  vertical-align: middle;
}

.cat-item.active {
  background: var(--primary-color);
  color: #ffffff;
  border-color: var(--primary-color);
  font-weight: bold;
}

.c-card {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.c-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.c-name {
  font-size: 28rpx;
  font-weight: bold;
}

.c-title {
  font-size: 22rpx;
  color: var(--sub-color);
  margin-top: 4rpx;
}

.c-score {
  font-size: 24rpx;
  color: var(--warning-color);
  font-weight: bold;
}

.c-intro {
  font-size: 24rpx;
  color: var(--text-color);
  margin: 14rpx 0;
  line-height: 1.4;
}

.c-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.c-footer {
  border-top: 1px solid #f0f0f0;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.c-time {
  font-size: 20rpx;
  color: var(--sub-color);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
