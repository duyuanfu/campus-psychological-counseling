.records-page {
  padding-bottom: 50rpx;
}

.tab-bar {
  background: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.tab-btn.active {
  color: var(--primary-color);
  font-weight: bold;
  border-bottom: 2px solid var(--primary-color);
}

.r-card {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.r-top {
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.r-counselor {
  font-size: 28rpx;
  font-weight: bold;
}

.row {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  line-height: 1.4;
  word-break: break-all;
}

.label {
  color: var(--sub-color);
  width: 140rpx;
  display: inline-block;
  flex-shrink: 0;
}

.time {
  color: var(--primary-color);
  font-weight: bold;
}

.feedback {
  color: var(--warning-color);
  background: #fffbe6;
  padding: 8rpx;
  border-radius: 4rpx;
}

.r-footer {
  border-top: 1px solid #f0f0f0;
  padding-top: 14rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.r-tip {
  font-size: 22rpx;
  color: var(--sub-color);
  white-space: nowrap;
  flex-shrink: 0;
}

.btn-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
