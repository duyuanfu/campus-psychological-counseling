.analytics-page {
  padding-bottom: 50rpx;
}

.stat-box {
  padding: 24rpx 0;
}

.stat-col {
  text-align: center;
  flex: 1;
}

.val {
  font-size: 36rpx;
  font-weight: bold;
}

.color-blue { color: #2d8cf0; }
.color-green { color: #19be6b; }
.color-orange { color: #ff9900; }

.lbl {
  font-size: 22rpx;
  color: var(--sub-color);
  margin-top: 6rpx;
}

.canvas-wrap {
  width: 100%;
  height: 400rpx;
}

.my-canvas {
  width: 100%;
  height: 100%;
}
