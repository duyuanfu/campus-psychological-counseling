<view class="container audit-page">
  <view class="card">
    <view class="section-title">树洞内容监控列表 ({{posts.length}})</view>
    <view wx:if="{{posts.length === 0}}" class="empty-tip">暂无树洞发帖内容</view>
    
    <view wx:for="{{posts}}" wx:key="id" class="post-item">
      <view class="p-header flex-between">
        <text class="p-author">{{item.anonymousName}} ({{item.tag}})</text>
        <button class="btn-danger btn-sm" bindtap="deletePost" data-id="{{item.id}}">违规下架</button>
      </view>
      <view class="p-text">{{item.content}}</view>
    </view>
  </view>
</view>
