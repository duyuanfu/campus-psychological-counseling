.audit-page {
  padding-bottom: 50rpx;
}

.tab-bar {
  background: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.tab-btn.active {
  color: var(--primary-color);
  font-weight: bold;
  border-bottom: 2px solid var(--primary-color);
}

.name {
  font-size: 28rpx;
  font-weight: bold;
}

.desc {
  font-size: 22rpx;
  color: var(--text-color);
  margin-top: 6rpx;
}
