<view class="container auth-page">
  <view class="card">
    <view class="section-title">学生学籍档案信息</view>

    <view class="form-group">
      <view class="form-label">真实姓名</view>
      <input class="form-input" value="{{name}}" bindinput="onInput" data-field="name" placeholder="姓名" />
    </view>

    <view class="form-group">
      <view class="form-label">学号</view>
      <input class="form-input" value="{{studentId}}" bindinput="onInput" data-field="studentId" placeholder="学号" />
    </view>

    <view class="form-group">
      <view class="form-label">就读学院</view>
      <picker bindchange="onCollegeChange" value="{{collegeIndex}}" range="{{colleges}}">
        <view class="form-picker">
          <text>{{colleges[collegeIndex]}}</text>
          <text>▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">专业与年级</view>
      <input class="form-input" value="{{majorGrade}}" bindinput="onInput" data-field="majorGrade" placeholder="专业 年级" />
    </view>

    <view class="form-group">
      <view class="form-label">手机号码</view>
      <input class="form-input" type="number" value="{{phone}}" bindinput="onInput" data-field="phone" placeholder="手机号" />
    </view>

    <button class="btn-primary btn-block" style="margin-top: 30rpx;" bindtap="saveAuth">保存认证信息</button>
  </view>
</view>
