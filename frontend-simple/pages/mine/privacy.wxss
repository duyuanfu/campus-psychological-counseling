.privacy-page {
  padding-bottom: 50rpx;
}

.setting-row {
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.setting-row:last-child {
  border-bottom: none;
}

.s-title {
  font-size: 26rpx;
  font-weight: bold;
}

.s-desc {
  font-size: 22rpx;
  color: var(--sub-color);
  margin-top: 4rpx;
}

.btn-block {
  width: 100% !important;
  padding: 22rpx 0 !important;
  font-size: 28rpx !important;
}
